[worldserver]

########################################
# mod-quest-drop-rate
#
# Raises only the drop chance of real quest items (QuestRequired = 1 in the
# *_loot_template tables). Applies to every loot type, fishing included.
#
# Unchanged: normal loot, references, items without a quest requirement and
# all Rate.Drop.Item.* values of worldserver.conf. Quest items in loot groups
# that also contain normal items stay unchanged as well, because any extra
# chance there would be taken from the other items of the group.
########################################

#
#    QuestDropRate.Enable
#        Description: Turn the module on or off.
#        Default:     1
#

QuestDropRate.Enable = 1

#
#    QuestDropRate.Multiplier
#        Description: Factor for the drop chance of quest items, capped at
#                     100 %. Values below 1 are invalid and leave the chances
#                     unchanged.
#        Example:     2.0 turns a 40 % chance into 80 %, and 60 % into 100 %.
#        Default:     2.0
#

QuestDropRate.Multiplier = 2.0
