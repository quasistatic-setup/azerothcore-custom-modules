[worldserver]

########################################
# mod-welcome-promos
#
# Sends every NEWLY created character a one-time welcome mail with historical
# promotional and special items.
#
# Triggered only when a character is created, not on login. Existing
# characters therefore receive nothing, not even later. Logging in again does
# not send another mail.
#
# Collector's Edition rewards keep working through the core's account flags
# and are not repeated here.
########################################

#
#    WelcomePromos.Enable
#        Description: Turn the module on or off.
#        Default:     1
#

WelcomePromos.Enable = 1

#
#    WelcomePromos.Items
#        Description: Item IDs of the attachments, comma-separated.
#                     Unknown IDs are skipped and logged, duplicates are sent
#                     only once. One mail holds at most twelve attachments;
#                     more items are split across several mails automatically.
#
#                     The default corresponds to:
#                       20371 Blue Murloc Egg (Murky)
#                       39656 Tyrael's Hilt
#                       43599 Big Blizzard Bear
#                       46767 Warbot Ignition Key
#                       46802 Heavy Murloc Egg (Grunty)
#                       49362 Onyxian Whelpling
#                       49646 Core Hound Pup
#                       49665 Pandaren Monk
#                       49693 Lil' Phylactery (Lil' K.T.)
#                       54847 Lil' XT
#

WelcomePromos.Items = "20371,39656,43599,46767,46802,49362,49646,49665,49693,54847"

#
#    WelcomePromos.SenderEntry
#        Description: creature_template entry used as sender.
#                     0 sends as a game master mail; the mailbox then shows the
#                     subject without a creature name.
#        Default:     0
#

WelcomePromos.SenderEntry = 0

#
#    WelcomePromos.Subject
#        Description: Mail subject. With several mails a counter such as
#                     "(1/2)" is appended.
#        Default:     "Special keepsakes"
#

WelcomePromos.Subject = "Special keepsakes"

#
#    WelcomePromos.Body
#        Description: Mail text.
#

WelcomePromos.Body = "Welcome to Azeroth! Attached you will find some special keepsakes from past promotions. May they accompany you on your travels."

#
#    WelcomePromos.ExcludedAccountPrefixes
#        Description: Additional account prefixes that receive no mail,
#                     comma-separated, case-insensitive.
#                     The Playerbot account prefix is always excluded; it is
#                     read from AiPlayerbot.RandomBotAccountPrefix so both
#                     sides cannot drift apart.
#        Default:     "" (none)
#

WelcomePromos.ExcludedAccountPrefixes = ""
