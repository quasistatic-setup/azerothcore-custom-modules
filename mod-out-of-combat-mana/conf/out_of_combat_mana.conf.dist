[worldserver]

########################################
# mod-out-of-combat-mana
#
# Multiplies the normal mana regeneration of players outside of combat.
# Applies to real players and to bots in a group or raid with a real player;
# free-roaming random bots stay normal.
#
# Unchanged: Rate.Mana of worldserver.conf, regeneration in combat, rage,
# energy, runic power, as well as pets, guardians and creatures. The
# five-second rule stays in effect: after casting, the interrupted
# regeneration value is multiplied, not the full one.
########################################

#
#    OutOfCombatMana.Enable
#        Description: Turn the module on or off.
#        Default:     1
#

OutOfCombatMana.Enable = 1

#
#    OutOfCombatMana.Multiplier
#        Description: Factor on the mana regeneration the core already computes
#                     outside of combat (including Rate.Mana). 1.0 is exactly
#                     the behaviour without the module. Values below 1 are
#                     invalid and act like 1.0.
#        Example:     2.0 doubles the regeneration outside of combat.
#        Default:     2.0
#

OutOfCombatMana.Multiplier = 2.0
