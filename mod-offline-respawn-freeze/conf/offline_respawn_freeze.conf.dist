[worldserver]

########################################
# mod-offline-respawn-freeze
#
# Pauses creature respawn timers while the server is not running.
#
# Background: creature_respawn.respawnTime is an absolute Unix time. Without
# this module respawn timers therefore keep running while the server is off.
# At startup the pending times are pushed back by exactly the downtime.
#
# Optionally the respawn timers also rest while the server runs but no human
# player is logged in. See FreezeWhileNoPlayerOnline.
#
# Explicitly not affected: GameObjects (herbs, ore, chests), auctions, mail,
# calendar, seasonal events and world time. No virtual clock is introduced;
# only one field of the creature_respawn table is adjusted.
########################################

#
#    OfflineRespawnFreeze.Enable
#        Description: Turn the module on or off.
#        Default:     1
#

OfflineRespawnFreeze.Enable = 1

#
#    OfflineRespawnFreeze.DryRun
#        Description: Dry run. The module computes and logs but changes
#                     nothing. For safely watching the first run.
#        Default:     0
#

OfflineRespawnFreeze.DryRun = 0

#
#    OfflineRespawnFreeze.FreezeWhileNoPlayerOnline
#        Description: Also pause respawn timers while the server runs but no
#                     human player is logged in.
#                     When the last human logs out, the pending respawns are
#                     parked and their remaining time is recorded; when the
#                     first human logs in, they get exactly that remaining
#                     time back. Bot sessions do not count as players
#                     (WorldSession::IsBot).
#                     Whatever the bots kill during the absence is not parked
#                     and respawns completely normally. The freeze only
#                     affects what the human player left behind.
#                     This also removes the need for the flat startup grace:
#                     if entries are parked at shutdown, they get their exact
#                     remaining time back at login.
#                     When turned off, the next start gives parked entries
#                     their remaining time back.
#                     Only sensible with a single human player or a single
#                     player group. The last logout and the first login count.
#        Default:     1
#

OfflineRespawnFreeze.FreezeWhileNoPlayerOnline = 1

#
#    OfflineRespawnFreeze.HeartbeatSeconds
#        Description: Interval at which the server updates its timestamp.
#                     This value is the maximum error after a crash. Smaller
#                     values are more accurate and write more often; 0 turns
#                     the heartbeat off, so no shift is possible after a crash.
#        Default:     60
#

OfflineRespawnFreeze.HeartbeatSeconds = 60

#
#    OfflineRespawnFreeze.StartupGraceSeconds
#        Description: Extra seconds added to the downtime at startup.
#                     Time passes between the server start and the moment you
#                     actually stand in the world: start the client, log in,
#                     choose a character, load the zone. That span would
#                     otherwise run against the respawns unchecked, all the
#                     more as bots are already playing and killing.
#                     300 means five minutes and covers the usual start-up.
#                     0 turns the grace off.
#                     Only applies when there is no anchor from a logout,
#                     that is with FreezeWhileNoPlayerOnline = 0 or after a
#                     crash while playing. Otherwise the login path settles
#                     the parked entries exactly.
#        Default:     300
#

OfflineRespawnFreeze.StartupGraceSeconds = 300

#
#    OfflineRespawnFreeze.MinDowntimeSeconds
#        Description: Below this downtime nothing is shifted at startup, so
#                     ordinary restarts have no effect. Parked entries get
#                     their remaining time back at login regardless of this
#                     value.
#        Default:     60
#

OfflineRespawnFreeze.MinDowntimeSeconds = 60

#
#    OfflineRespawnFreeze.MaxDowntimeDays
#        Description: Above this downtime the startup only logs and changes
#                     nothing. Protection against nonsensical values, for
#                     example from a wrongly set system clock. If the logout
#                     lies further back, parked respawns appear immediately at
#                     login.
#        Default:     60
#

OfflineRespawnFreeze.MaxDowntimeDays = 60

#
#    OfflineRespawnFreeze.MaxFutureDays
#        Description: Respawn times further in the future than this stay
#                     untouched.
#                     Important: in instances with a reset period AzerothCore
#                     sets respawnTime to "now + one year" to mark that a
#                     creature does not return before the instance reset
#                     (Map::SaveCreatureRespawnTime). That is a marker, not a
#                     real time, and must not be shifted. This value
#                     protects it.
#        Default:     30
#

OfflineRespawnFreeze.MaxFutureDays = 30

#
#    OfflineRespawnFreeze.MaxSpawnTimeSecs
#        Description: Spawns whose own respawn time (creature.spawntimesecs)
#                     exceeds this value are not shifted; they keep following
#                     real time.
#                     Background: the freeze turns calendar time into play
#                     time. For ordinary creatures this is not noticeable,
#                     their respawn time is mostly below five minutes. For
#                     rare elite spawns with 8 to 42 hours and for event NPCs
#                     the effect reverses: with a few hours of play per day
#                     they would stay away for weeks, although their event
#                     follows the calendar.
#                     0 disables the exception, then everything is shifted.
#        Default:     1800
#

OfflineRespawnFreeze.MaxSpawnTimeSecs = 1800

#
#    OfflineRespawnFreeze.IncludeInstances
#        Description: Also shift respawn times inside instances.
#                     Note: ordinary instances without a bind lose their
#                     respawn entries anyway as soon as the last player
#                     leaves. The setting therefore matters for heroic
#                     dungeons and raids, where a bind exists.
#                     Instance binds themselves are not shifted; they expire
#                     by real calendar time.
#        Default:     1
#

OfflineRespawnFreeze.IncludeInstances = 1
